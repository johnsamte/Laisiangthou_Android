<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    android:scrollbars="none"
    android:background="?attr/colorSurface">

<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="?attr/colorSurface">

        <TextView
            android:id="@+id/fontOptionRobotoMono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            android:text="Roboto Mono"
            android:padding="12dp"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/tickRoboto"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:layout_alignTop="@id/fontOptionRobotoMono"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/tick"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/fontOptionLoraItalic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            android:text="Lora Italic"
            android:padding="12dp"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_below="@+id/fontOptionRobotoMono"/>

        <ImageView
            android:id="@+id/tickLoraItalic"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_below="@+id/tickRoboto"
            android:layout_alignParentStart="true"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/tick"
            android:layout_alignTop="@id/fontOptionLoraItalic"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/fontOptionOpenSans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            android:text="Open Sans"
            android:padding="12dp"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_below="@+id/fontOptionLoraItalic"/>

        <ImageView
            android:id="@+id/tickOpenSans"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_below="@+id/tickLoraItalic"
            android:layout_alignParentStart="true"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/tick"
            android:layout_alignTop="@id/fontOptionOpenSans"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/fontOptionGreatVibes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            android:text="Great Vibes"
            android:textStyle="bold"
            android:padding="12dp"
            android:textSize="18sp"
            android:layout_below="@+id/fontOptionOpenSans"/>

        <ImageView
            android:id="@+id/tickGreatVibes"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_below="@+id/tickOpenSans"
            android:layout_alignParentStart="true"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/tick"
            android:layout_alignTop="@id/fontOptionGreatVibes"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/fontOptionBasker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            android:text="Baskerv Villesc"
            android:textStyle="bold"
            android:padding="12dp"
            android:textSize="18sp"
            android:layout_below="@+id/fontOptionGreatVibes"/>

        <ImageView
            android:id="@+id/tickBasker"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_below="@+id/tickGreatVibes"
            android:layout_alignParentStart="true"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/tick"
            android:layout_alignTop="@id/fontOptionBasker"
            android:visibility="gone"/>

    </RelativeLayout>
</ScrollView>