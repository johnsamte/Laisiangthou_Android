<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/multicolor_stroke.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Stroke Layer (Outer) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#d71920"
                android:centerColor="#f6ff00"
                android:endColor="#00a651"
                android:type="linear" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Inner Shape (Content Background) -->
    <item android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bw" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
