<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:layout_gravity="end"
    android:background="@color/bw">

    <!-- TEXT SIZE -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_text_format_size"
            android:contentDescription="textSukletna"
            android:padding="4dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/text_slider"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:valueFrom="10"
            android:valueTo="30"
            android:stepSize="0"
            app:labelBehavior="gone"
            android:contentDescription="textSukletna"
            app:thumbHeight="20dp"/>
        <TextView
            android:id="@+id/textSizeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="30"
            android:layout_marginEnd="8dp"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- LINE SPACING -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_format_line_spacing"
            android:contentDescription="textSukkakna"
            android:padding="4dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/text_line_slider"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:valueFrom="0.5"
            android:valueTo="4"
            android:stepSize="0"
            app:labelBehavior="gone"
            android:contentDescription="textSukkakna"
            app:thumbHeight="20dp"/>
        <TextView
            android:id="@+id/textLineValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="30"
            android:layout_marginEnd="8dp"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
